#Requires AutoHotkey v1.1.37.02
#SingleInstance Force
#Persistent
#InstallKeybdHook
#InstallMouseHook
SetBatchLines, -1

LLARS_SCRIPT_TYPE := "RunCount"

if !LLARS_FrameworkAvailable()
	LLARS_FrameworkError()

LLARS_Initialize()

return

Start:

LLARS_RunCount(Func("Run"))

return

; =========================================================================
; |     >>> BEGIN SCRIPT EDITING <<<     >>> BEGIN SCRIPT EDITING <<<     |
; =========================================================================

; ================================================================
; SCRIPT_EDIT_BEGIN_4C4C415253
; ================================================================

Run(ctx)
{
	global

	LLARS_SetStatus("Banking", "Gems")
	LLARS_RedClick("Bank Coords")

	LLARS_Sleep("Sleep Brief")

	LLARS_SetStatus("Cutting", "Gems")
	LLARS_PressHotkey("Skillbar Hotkey")

	LLARS_Sleep("Sleep Short")

	LLARS_PressKey("Space")

	LLARS_Sleep("Sleep Craft", true)
}

; Declarative timing model: no total runtime is hard-coded. Values continue to
; come from Config.ini, and Random Sleep keeps its configured probability.
LLARS_RuntimeEstimateMetadata()
{
	model := LLARS_RuntimeMetadataCreate("modeled")
	LLARS_RuntimeMetadataAddSection(model, "Sleep Brief", 1)
	LLARS_RuntimeMetadataAddSection(model, "Sleep Short", 1)
	LLARS_RuntimeMetadataAddSection(model, "Sleep Craft", 1, "both", 1.0, "script", true)
	return model
}


; ================================================================
; SCRIPT_EDIT_END_4C4C415253
; ================================================================

; ==================================================================
; |     >>> END SCRIPT EDITING <<<     >>> END SCRIPT EDITING <<<  |
; ==================================================================

return
LLARS_FrameworkAvailable()
{
	dir := A_ScriptDir

	Loop, 12
	{
		if (FileExist(dir . "\Core\LLARS.ahk") && FileExist(dir . "\LLARS Config.ini"))
			return true

		SplitPath, dir,, parentDir

		if (parentDir = "" || parentDir = dir)
			break

		dir := parentDir
	}

	return false
}

LLARS_FrameworkError()
{
	Menu, Tray, NoIcon

	MsgBox, 4112, LLARS Error, The complete LLARS project could not be found.`n`nIf you opened this script from a ZIP, RAR, or 7Z archive, extract the entire LLARS folder before running it.

	ExitApp
}

